            "state" : "translated",
            "value" : "Die Stiche ergeben zusammen %1$lld, diese Runde hat aber %2$lld Stiche. Tippe in der Tabelle auf einen Wert, um ihn zu korrigieren, und schliesse die Runde dann ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
