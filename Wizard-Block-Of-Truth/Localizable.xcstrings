    "UI.MultiplayerLobby.Seats.Footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Reihenfolge bestimmt den Geberwechsel und die Reihenfolge der Ansagen. Benenne die Plätze ohne Handy; Gäste wählen einen freien Platz und geben ihren Namen ein. Mit „Sortieren“ verschiebst du Plätze; wische über den Platz eines Gasts, um sein Handy zu entfernen."
