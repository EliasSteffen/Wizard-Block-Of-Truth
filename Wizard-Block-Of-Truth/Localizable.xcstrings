    "Error.Multiplayer.Connection.CommandTimedOut" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Host hat nicht rechtzeitig geantwortet. Prüfe die Tabelle und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host didn’t answer in time. Check the scoreboard and try again."
          }
        }
      }
    },
    "Error.Multiplayer.Connection.HostIncompatible" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Host antwortet nicht. Möglicherweise verwendet er eine ältere App-Version – aktualisiere beide Geräte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The host doesn’t answer. It may be using an older app version – update both devices."
          }
        }
      }
    },
    "Error.Multiplayer.Connection.HostUnreachable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
